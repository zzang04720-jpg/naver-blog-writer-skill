# 네이버 검색광고 API - searchad.naver.com → 도구 → API 사용 관리
NAVER_AD_CUSTOMER_ID=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=

# NAVER API HUB Application 인증 키 (console.ncloud.com)
# 변수명은 유지하지만 구 개발자센터 키가 아닌 API HUB 키를 넣습니다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 본인 소유 공개 GitHub 이미지 저장소: owner/repo
# Fine-grained PAT: 해당 저장소만 선택, Contents Read and write
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
